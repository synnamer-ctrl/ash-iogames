{
  "name": "little-wonder-world",
  "private": true,
  "version": "1.0.0",
  "description": "Little Wonder World — an illustrated, open-ended digital toybox for children (PWA).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run assets:check && tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "assets": "node scripts/art/generate.mjs",
    "assets:check": "node scripts/check-assets.mjs",
    "icons": "node scripts/render-icons.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "phaser": "^3.90.0",
    "react": "^19.1.10",
    "react-dom": "^19.1.10"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "@types/react": "19.1",
    "@types/react-dom": "19.1",
    "@vitejs/plugin-react": "^4.7.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
