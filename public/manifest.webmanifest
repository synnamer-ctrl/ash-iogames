{
  "name": "Little Wonder World",
  "short_name": "Wonder World",
  "description": "An illustrated toybox to tap, drag, build, draw and discover.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "orientation": "any",
